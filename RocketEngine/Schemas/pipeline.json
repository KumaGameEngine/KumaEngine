{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PipelineFile",
  "type": "object",
  "properties": {
    "Passes": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PassFile"
      }
    },
    "VertexDefinition": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "$ref": "#/$defs/RoketVertexElement"
      },
      "description": "Maps attribute names to their vertex element type (e.g. 'aPosition': 'Position')"
    }
  },
  "$defs": {
    "PassFile": {
      "title": "PassFile",
      "type": "object",
      "properties": {
        "Type": {
          "title": "Type",
          "type": "string",
          "enum": [
            "Graphics",
            "Compute"
          ]
        },
        "Output": {
          "type": "string",
          "default": "MainSwapchain",
          "description": "Name of the swapchain or render target this pass writes to"
        },
        "VertexShader": {
          "type": "string",
          "default": "",
          "description": "Path or name of the vertex shader"
        },
        "FragmentShader": {
          "type": "string",
          "default": "",
          "description": "Path or name of the fragment shader"
        },
        "ComputeShader": {
          "type": "string",
          "default": "",
          "description": "Path or name of the compute shader (mutually exclusive with vertex/fragment)"
        },
        "ThreadGroupSizeX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "ThreadGroupSizeY": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "ThreadGroupSizeZ": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "GroupCountX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "GroupCountY": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "GroupCountZ": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "AutoGroups ": {
          "type": "boolean",
          "default": false
        },
        "ComputePerObject ": {
          "type": "boolean",
          "default": false
        },
        "Uniforms": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "$ref": "#/$defs/RoketPipelineUniforms"
          },
          "description": "Maps uniform binding names to their semantic role"
        }
      }
    },
    "RoketPipelineUniforms": {
      "title": "RoketPipelineUniforms",
      "type": "string",
      "enum": [
        "CameraProjView",
        "CameraProjViewInverse",
        "CameraPos",
        "ObjectModelMatrix",
        "SamplerCube",
        "Sampler2D",
        "Sampler3D",
        "Lights"
      ]
    },
    "RoketVertexElement": {
      "title": "RoketVertexElement",
      "type": "string",
      "enum": [
        "UV",
        "UVW",
        "Position",
        "Normal",
        "Color",
        "Tangent"
      ]
    }
  }
}