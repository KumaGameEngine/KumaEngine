{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PipelineFile",
  "type": "object",
  "properties": {
    "Passes": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/PassFile"
      }
    },
    "VertexDefinition": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "$ref": "#/$defs/RoketVertexElement"
      },
      "description": "Maps attribute names to their vertex element type (e.g. 'aPosition': 'Position')"
    }
  },
  "$defs": {
    "PassFile": {
      "title": "PassFile",
      "type": "object",
      "properties": {
        "Type": {
          "title": "Type",
          "type": "string",
          "enum": [
            "Graphics",
            "Compute"
          ]
        },
        "Output": {
          "type": "string",
          "default": "MainSwapchain",
          "description": "Name of the swapchain or render target this pass writes to"
        },
        "VertexShader": {
          "type": "string",
          "default": "",
          "description": "Path or name of the vertex shader"
        },
        "FragmentShader": {
          "type": "string",
          "default": "",
          "description": "Path or name of the fragment shader"
        },
        "ComputeShader": {
          "type": "string",
          "default": "",
          "description": "Path or name of the compute shader (mutually exclusive with vertex/fragment)"
        },
        "ThreadGroupSizeX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "ThreadGroupSizeY": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "ThreadGroupSizeZ": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "GroupCountX": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "GroupCountY": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "GroupCountZ": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 1
        },
        "AutoGroups": {
          "type": "boolean",
          "default": false
        },
        "ComputePerObject": {
          "type": "boolean",
          "default": false
        },
        "DepthTest": {
          "type": "boolean",
          "default": true
        },
        "DepthWrite": {
          "type": "boolean",
          "default": true
        },
        "DepthComparison": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "$ref": "#/$defs/RoketPipelineUniforms"
          }
        },
        "CullMode": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "$ref": "#/$defs/CullMode"
          }
        },
        "FillMode": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "$ref": "#/$defs/PolygonFillMode"
          }
        },
        "FrontFace": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "$ref": "#/$defs/FrontFace"
          }
        },
        "DepthClipEnabled": {
          "type": "boolean",
          "default": true
        },
        "ScissorTestEnabled": {
          "type": "boolean",
          "default": true
        },
        "UseLights": {
          "type": "boolean",
          "default": false
        },
        "Uniforms": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "anyOf": [
              { "$ref": "#/$defs/RoketPipelineUniforms" },
              { "$ref": "#/$defs/CustomUniform" },
              { "$ref": "#/$defs/CustomUniformRef" }
            ]
          },
          "description": "Maps uniform binding names to their semantic role"
        },
        "Samplers": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "$ref": "#/$defs/RoketPipelineSamplers"
          },
          "description": "Maps sampler binding names to their semantic role"
        }
      }
    },
    "RoketPipelineUniforms": {
      "title": "RoketPipelineUniforms",
      "type": "string",
      "enum": [
        "CameraProjView",
        "CameraProjViewInverse",
        "CameraPos",
        "ObjectModelMatrix"
      ]
    },
    "CustomUniform": {
      "title": "CustomUniform",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*;(?:ro|rw);(?:[0-9]+|auto)(?:;[0-9]+)?$",
      "description": "Custom uniform in the form <name>;<access>;<count>|auto;[stride]",
      "examples": [
        "Lights;ro;auto",
        "Particles;rw;1024;32"
      ]
    },
    "CustomUniformRef": {
      "title": "CustomUniformRef",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Reference to a custom uniform defined elsewhere by name"
    },
    "RoketPipelineSamplers": {
      "title": "RoketPipelineSamplers",
      "type": "string",
      "enum": [
        "SamplerCube",
        "Sampler2D",
        "Sampler3D"
      ]
    },
    "ComparisonKind": {
      "title": "ComparisonKind",
      "type": "string",
      "enum": [
        "Never",
        "Less",
        "Equal",
        "LessEqual",
        "Greater",
        "NotEqual",
        "GreaterEqual",
        "Always"
      ]
    },
    "CullMode": {
      "title": "CullMode",
      "type": "string",
      "enum": [
        "None",
        "Front",
        "Back"
      ]
    },
    "PolygonFillMode": {
      "title": "PolygonFillMode",
      "type": "string",
      "enum": [
        "Solid",
        "Wireframe"
      ]
    },
    "FrontFace": {
      "title": "FrontFace",
      "type": "string",
      "enum": [
        "Clockwise",
        "CounterClockwise"
      ]
    },
    "RoketVertexElement": {
      "title": "RoketVertexElement",
      "type": "string",
      "enum": [
        "UV",
        "UVW",
        "Position",
        "Normal",
        "Color",
        "Tangent"
      ]
    }
  }
}